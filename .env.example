# Telegram Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_chat_id_here

# Uptime Kuma Push Monitor (Optional)
KUMA_PUSH_URL=http://172.17.0.1:3001/api/push/YOUR_KUMA_TOKEN_HERE?status=up&msg=OK&ping=

# File Paths
STATE_FILE=/app/monitor_state.json

# Monitoring Configuration
CHECK_INTERVAL=300
PING_COUNT=1
PING_TIMEOUT=1

# WAN Links - Main (LTC)
LTC_H3_NAME=LTC_H3 (Main)
LTC_H3_IP=202.137.147.163
LTC_H4_NAME=LTC_H4 (Main)
LTC_H4_IP=202.137.147.164

# WAN Links - Backup (ETL)
ETL_H3_NAME=ETL_H3 (Backup)
ETL_H3_IP=114.129.29.226
ETL_H4_NAME=ETL_H4 (Backup)
ETL_H4_IP=114.129.29.227

# Alert Messages (Optional - สามารถปรับแต่งได้)
MSG_CRITICAL=🚨 **วิกฤต! โรงงานดับสนิท** 🚨\nเวลา: {time}\nตรวจสอบด่วน!
MSG_FAILOVER=⚠️ **แจ้งเตือน: Main ล่ม!**\nวิ่งเส้นสำรอง ETL 🔄\nเวลา: {time}
MSG_NORMAL=✅ **ระบบกลับมาปกติแล้ว**\nLTC Online 🚀\nเวลา: {time}